{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seekapp-scope-demo",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "LIVE_ENABLED": "true",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "ALLOWED_ORIGINS": "https://seekapp.net,https://seekapp-scope-demo.canemmobile.workers.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFRhslKFmU7t7yto",
    "SOURCE_URL": "https://github.com/seekapp-scope/seekapp-scope-demo",
    "DAILY_LIMIT": "20",
    "PER_IP_LIMIT": "3"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "DemoBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DemoBudget"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "account_id": "970e04c2f208851a9c256a2d0ddad5da",
  "routes": [
    {
      "pattern": "seekapp.net/demo*",
      "zone_id": "4b23068717b61c2a36e2411a90072929"
    },
    {
      "pattern": "seekapp.net/api/scope*",
      "zone_id": "4b23068717b61c2a36e2411a90072929"
    }
  ]
}
